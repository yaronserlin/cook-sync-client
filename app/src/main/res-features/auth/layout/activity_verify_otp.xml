<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_28"
        android:paddingEnd="@dimen/dp_28"
        android:paddingTop="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_32">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text" />

        <TextView
            android:id="@+id/tv_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verify_otp_title"
            android:textSize="@dimen/sp_26"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/color_text"
            android:layout_marginBottom="@dimen/dp_8" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_text"
            android:alpha="0.65"
            android:lineSpacingExtra="@dimen/dp_3"
            android:layout_marginBottom="@dimen/dp_32"
            tools:text="Enter the 6-digit code we sent to you@example.com to finish creating your account." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_otp_code"
            style="@style/CookSync.FieldLabel" />

        <EditText
            android:id="@+id/et_otp_code"
            style="@style/CookSync.Input.Code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_otp_code"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/tv_otp_code_error"
            style="@style/CookSync.ErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify"
            style="@style/CookSync.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:text="@string/action_verify" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resend"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_resend_code" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_gravity="center_horizontal"
            android:indeterminateTint="@color/color_accent"
            android:visibility="gone"
            android:layout_marginTop="@dimen/dp_16" />

    </LinearLayout>

</ScrollView>
