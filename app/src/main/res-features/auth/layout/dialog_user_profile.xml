<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_info_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/dp_24">

    <com.cooksync.app.ui.common.AvatarView
        android:id="@+id/avatar_view"
        android:layout_width="@dimen/dp_84"
        android:layout_height="@dimen/dp_84" />

    <TextView
        android:id="@+id/tv_full_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:fontFamily="@font/caprasimo"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_22"
        tools:text="Jane Smith" />

    <TextView
        android:id="@+id/tv_city"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:textColor="@color/color_accent_600"
        android:textSize="@dimen/sp_14"
        android:visibility="gone"
        tools:text="Tel Aviv, Israel"
        tools:visibility="visible" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginVertical="@dimen/dp_16"
        android:background="@color/color_divider" />

    <TextView
        android:id="@+id/tv_bio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/dp_4"
        android:textColor="@color/color_neutral_800"
        android:textSize="@dimen/sp_15"
        tools:text="Passionate home cook, baker, and recipe creator." />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/dp_20"
        android:visibility="gone" />

</LinearLayout>
