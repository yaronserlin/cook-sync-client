<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_bg">

    <include
        android:id="@+id/skeleton_container"
        layout="@layout/activity_register_skeleton"
        android:visibility="visible" />

    <ScrollView
        android:id="@+id/form_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/dp_28"
            android:paddingEnd="@dimen/dp_28"
            android:paddingTop="@dimen/dp_24"
            android:paddingBottom="@dimen/dp_32">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="@dimen/dp_32">

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_marginEnd="@dimen/dp_8"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="@dimen/dp_8"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/color_text" />

                <TextView
                    android:id="@+id/tv_headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/register_title"
                    android:textSize="@dimen/sp_26"
                    android:fontFamily="@font/caprasimo"
                    android:textColor="@color/color_text" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_first_name"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_first_name"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_first_name"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:maxLength="50"
                android:autofillHints="name"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_first_name_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_last_name"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_last_name"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_last_name"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionNext"
                android:maxLength="50"
                android:autofillHints="familyName"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_last_name_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_email"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:maxLength="254"
                android:autofillHints="emailAddress"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_email_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password"
                style="@style/CookSync.FieldLabel" />

            <com.cooksync.app.ui.common.PasswordEditText
                android:id="@+id/et_password"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                android:imeOptions="actionNext"
                android:maxLength="100"
                android:autofillHints="newPassword"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_password_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_repeat_password"
                style="@style/CookSync.FieldLabel" />

            <com.cooksync.app.ui.common.PasswordEditText
                android:id="@+id/et_repeat_password"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                android:imeOptions="actionDone"
                android:maxLength="100"
                android:autofillHints="newPassword"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_repeat_password_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_terms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_terms_accepted"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_13"
                app:buttonTint="@color/color_accent" />

            <TextView
                android:id="@+id/tv_terms_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_36"
                android:visibility="gone" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_marketing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_20"
                android:text="@string/label_marketing_opt_in"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_13"
                app:buttonTint="@color/color_accent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_account"
                style="@style/CookSync.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_create_account_submit"
                android:layout_marginBottom="@dimen/dp_12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_have_account"
                style="@style/CookSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_already_have_account"
                android:layout_marginBottom="@dimen/dp_24" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="@dimen/dp_36"
                android:layout_height="@dimen/dp_36"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/color_accent"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
