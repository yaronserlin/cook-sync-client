<?xml version="1.0" encoding="utf-8"?>
<!--
  Register skeleton layout: bone-for-bone placeholder of activity_register.xml.
  Five skeleton_field includes (first name, last name, email, password, repeat password)
  plus two button bones at the bottom. Animated by SkeletonHelper in RegisterActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeleton_register_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="64dp"
    android:paddingBottom="32dp">

    <!-- ── Brand wordmark bone ──────────────────────────────────────── -->
    <View
        android:layout_width="160dp"
        android:layout_height="42dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- ── Headline bone ────────────────────────────────────────────── -->
    <View
        android:layout_width="200dp"
        android:layout_height="28dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- ── First name field ──────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Last name field ───────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Email field ───────────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Password field ────────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Repeat password field ─────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Primary (create account) button bone ──────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_skeleton_bone_dark" />

    <!-- ── Secondary (have account) button bone ──────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_skeleton_bone" />

</LinearLayout>
