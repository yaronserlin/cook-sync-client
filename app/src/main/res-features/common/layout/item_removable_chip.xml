<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_removable"
    style="@style/Widget.MaterialComponents.Chip.Entry"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:checkable="false"
    android:clickable="false"
    android:focusable="false"
    android:fontFamily="@font/figtree"
    android:textColor="@color/color_accent_800"
    android:textSize="11.5sp"
    app:chipBackgroundColor="@color/color_accent_200"
    app:chipCornerRadius="14dp"
    app:chipMinHeight="28dp"
    app:closeIconEnabled="true"
    app:closeIconSize="16dp"
    app:closeIconTint="@color/color_accent_800"
    app:closeIconVisible="true"
    app:ensureMinTouchTargetSize="false" />
