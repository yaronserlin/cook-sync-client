<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_8"
    android:background="@drawable/bg_info_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/dp_14">

    <TextView
        android:id="@+id/tv_unit_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_accent"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="@dimen/dp_10"
        android:paddingVertical="@dimen/dp_4"
        android:textColor="@color/color_accent_700"
        android:textSize="@dimen/sp_13"
        tools:text="tbsp" />

    <TextView
        android:id="@+id/tv_unit_name"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_12"
        android:layout_weight="1"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_15"
        tools:text="Tablespoon" />

    <ImageButton
        android:id="@+id/btn_delete_unit"
        android:layout_width="@dimen/dp_36"
        android:layout_height="@dimen/dp_36"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/action_delete"
        android:src="@drawable/ic_delete"
        app:tint="@color/color_danger" />

</LinearLayout>
