<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingTop="@dimen/dp_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_user_search"
            style="@style/CookSync.Input"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/admin_users_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btn_user_sort"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_sort"
            android:padding="@dimen/dp_9"
            android:src="@drawable/ic_sort"
            app:tint="@color/color_text" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_users_all"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_users_filter_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_users_active"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:text="@string/admin_users_filter_active" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_users_deactivated"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:text="@string/admin_users_filter_deactivated" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_users_suspended"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_6"
                android:text="@string/admin_users_filter_suspended" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_users_count_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_13"
        android:layout_marginBottom="@dimen/dp_8"
        android:alpha="0.55"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_10_5"
        android:textStyle="bold"
        tools:text="812 users" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_users"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/dp_16" />

    <TextView
        android:id="@+id/tv_users_empty"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/admin_users_empty"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_13"
        android:visibility="gone" />

</LinearLayout>
