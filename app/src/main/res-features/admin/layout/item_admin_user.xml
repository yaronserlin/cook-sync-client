<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="@dimen/dp_13">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.cooksync.app.ui.common.AvatarView
            android:id="@+id/user_avatar"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36" />

        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_13_5"
                    android:textStyle="bold"
                    tools:text="Dana Cohen" />

                <TextView
                    android:id="@+id/tv_user_admin_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:background="@drawable/bg_pill_solid"
                    android:backgroundTint="@color/color_neutral_900"
                    android:paddingHorizontal="@dimen/dp_7"
                    android:paddingVertical="@dimen/dp_2"
                    android:textColor="@color/color_neutral_100"
                    android:textSize="@dimen/sp_9"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="ADMIN"
                    tools:visibility="visible" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_user_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_1"
                android:alpha="0.6"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_11_5"
                tools:text="dana.cohen@example.com" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_user_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_solid"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_3"
            android:textSize="@dimen/sp_9_5"
            android:textStyle="bold"
            tools:backgroundTint="@color/color_accent_2_200"
            tools:text="ACTIVE"
            tools:textColor="@color/color_accent_2_800" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_user_toggle_enabled"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_36"
            android:layout_weight="1"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:textSize="@dimen/sp_12"
            app:cornerRadius="@dimen/dp_18"
            app:strokeWidth="@dimen/dp_1_5"
            tools:strokeColor="@color/color_danger"
            tools:text="Suspend"
            tools:textColor="@color/color_danger" />

        <ImageButton
            android:id="@+id/btn_user_email"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_marginStart="@dimen/dp_6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_email_user_desc"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_mail"
            app:tint="@color/color_text" />

    </LinearLayout>

</LinearLayout>
