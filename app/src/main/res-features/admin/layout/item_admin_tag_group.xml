<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="@dimen/dp_13">

    <TextView
        android:id="@+id/tv_group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.55"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_10_5"
        android:textStyle="bold"
        tools:text="vegan" />

    <LinearLayout
        android:id="@+id/ll_group_variants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tv_group_merge_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/dp_4"
        android:padding="@dimen/dp_4"
        android:text="@string/admin_merge_action"
        android:textColor="@color/color_accent_700"
        android:textSize="@dimen/sp_12"
        android:textStyle="bold" />

</LinearLayout>
