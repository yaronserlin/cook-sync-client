<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="13dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.cooksync.app.ui.common.AvatarView
            android:id="@+id/report_user_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tv_report_reviewer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Dana Cohen" />

        <TextView
            android:id="@+id/tv_report_recipe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:alpha="0.55"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_text"
            android:textSize="11sp"
            tools:text="on Shakshuka with feta" />

        <TextView
            android:id="@+id/tv_report_reason_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_solid"
            android:backgroundTint="@color/color_accent_200"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:textColor="@color/color_accent_800"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="SPAM" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_report_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:alpha="0.85"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/color_text"
        android:textSize="12.5sp"
        tools:text="This looks like a copy-pasted comment from another site." />

    <!-- The reporter's own note explaining why they filed the report (ReportedReviewResponse#reportComment),
         distinct from tv_report_comment above (the review's own text). Only shown when non-blank. -->
    <TextView
        android:id="@+id/tv_report_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_info_card"
        android:padding="9dp"
        android:textColor="@color/color_text"
        android:textSize="11.5sp"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="Reporter note: this is the third time this account has posted the same spam link."
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_remove"
            style="@style/CookSync.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/action_remove"
            android:textColor="@color/color_neutral_100"
            android:textSize="12.5sp"
            app:backgroundTint="@color/color_neutral_900"
            app:cornerRadius="19dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_keep"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/action_keep"
            android:textSize="12.5sp"
            app:cornerRadius="19dp" />

        <ImageButton
            android:id="@+id/btn_report_ban"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_ban_user_desc"
            android:padding="9dp"
            android:src="@drawable/ic_user_x"
            app:tint="@color/color_text" />

    </LinearLayout>

</LinearLayout>
