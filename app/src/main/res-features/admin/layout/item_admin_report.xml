<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_10"
    android:background="@drawable/bg_card_outline"
    android:orientation="vertical"
    android:padding="@dimen/dp_13">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.cooksync.app.ui.common.AvatarView
            android:id="@+id/report_user_avatar"
            android:layout_width="@dimen/dp_32"
            android:layout_height="@dimen/dp_32"
            android:layout_marginEnd="@dimen/dp_8" />

        <TextView
            android:id="@+id/tv_report_reviewer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_12_5"
            android:textStyle="bold"
            tools:text="Dana Cohen" />

        <TextView
            android:id="@+id/tv_report_recipe"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:alpha="0.55"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_11"
            tools:text="on Shakshuka with feta" />

        <TextView
            android:id="@+id/tv_report_reason_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_solid"
            android:backgroundTint="@color/color_accent_200"
            android:paddingHorizontal="@dimen/dp_9"
            android:paddingVertical="@dimen/dp_3"
            android:textColor="@color/color_accent_800"
            android:textSize="@dimen/sp_10"
            android:textStyle="bold"
            tools:text="SPAM" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_report_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:alpha="0.85"
        android:lineSpacingMultiplier="1.15"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_12_5"
        tools:text="This looks like a copy-pasted comment from another site." />

    <!-- The reporter's own note explaining why they filed the report (ReportedReviewResponse#reportComment),
         distinct from tv_report_comment above (the review's own text). Only shown when non-blank. -->
    <TextView
        android:id="@+id/tv_report_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:background="@drawable/bg_info_card"
        android:padding="@dimen/dp_9"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_11_5"
        android:textStyle="italic"
        android:visibility="gone"
        tools:text="Reporter note: this is the third time this account has posted the same spam link."
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_remove"
            style="@style/CookSync.Button.Primary"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_38"
            android:layout_weight="1"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:text="@string/action_remove"
            android:textColor="@color/color_neutral_100"
            android:textSize="@dimen/sp_12_5"
            app:backgroundTint="@color/color_neutral_900"
            app:cornerRadius="@dimen/dp_19" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_keep"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_38"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:text="@string/action_keep"
            android:textSize="@dimen/sp_12_5"
            app:cornerRadius="@dimen/dp_19" />

        <ImageButton
            android:id="@+id/btn_report_ban"
            android:layout_width="@dimen/dp_38"
            android:layout_height="@dimen/dp_38"
            android:layout_marginStart="@dimen/dp_6"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_ban_user_desc"
            android:padding="@dimen/dp_9"
            android:src="@drawable/ic_user_x"
            app:tint="@color/color_text" />

    </LinearLayout>

</LinearLayout>
