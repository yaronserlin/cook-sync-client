<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_reason_all"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_reason_all" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_reason_spam"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/admin_reason_spam" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_reason_abuse"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/admin_reason_abuse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chip_reason_off_topic"
                style="@style/CookSync.Button.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/admin_reason_off_topic" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/tv_reports_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.55"
        android:letterSpacing="0.12"
        android:text="@string/admin_reports_section_label"
        android:textAllCaps="true"
        android:textColor="@color/color_text"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_reports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tv_reports_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/admin_reports_empty"
        android:textColor="@color/color_text"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
