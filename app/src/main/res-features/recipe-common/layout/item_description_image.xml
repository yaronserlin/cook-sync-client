<?xml version="1.0" encoding="utf-8"?>
<!-- A single supplementary photo (+ optional caption) shown inline within the recipe
     description, matching the design's descBlocks "figure" concept: a full-width rounded
     image with an optional figcaption below it, interspersed with text blocks rather than
     shown in a horizontal-scroll gallery. The image container is ratio-locked (16:9) instead
     of a fixed height so crop behavior is consistent regardless of source photo dimensions. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_10">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/description_image_card"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        app:cardCornerRadius="@dimen/dp_16"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="@dimen/dp_0">

        <ImageView
            android:id="@+id/description_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/description_image_caption"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:alpha="0.6"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/description_image_card"
        tools:text="The syrup should coat the back of a spoon." />

</androidx.constraintlayout.widget.ConstraintLayout>
