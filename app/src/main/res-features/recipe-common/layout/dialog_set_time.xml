<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/dp_24"
    android:paddingVertical="@dimen/dp_8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Hours -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_hours"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:letterSpacing="0.1"
                android:text="@string/label_hours"
                android:textColor="@color/color_accent_700"
                android:textSize="@dimen/sp_10_5"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:text="@string/label_time_separator"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <!-- Minutes -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_minutes"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:letterSpacing="0.1"
                android:text="@string/label_minutes"
                android:textColor="@color/color_accent_700"
                android:textSize="@dimen/sp_10_5"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Separator 2 (Seconds) -->
        <TextView
            android:id="@+id/tv_seconds_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/dp_4"
            android:text="@string/label_time_separator"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_20"
            android:textStyle="bold" />

        <!-- Seconds -->
        <LinearLayout
            android:id="@+id/container_seconds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_seconds"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:letterSpacing="0.1"
                android:text="@string/label_seconds"
                android:textColor="@color/color_accent_700"
                android:textSize="@dimen/sp_10_5"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
