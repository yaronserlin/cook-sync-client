<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.recipe.search.SearchActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingTop="@dimen/dp_12">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"
            android:padding="@dimen/dp_8"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/color_text" />

        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginEnd="@dimen/dp_4"
            android:background="@drawable/bg_input"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="@string/search_hint" />

        <FrameLayout
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_4">

            <ImageButton
                android:id="@+id/btn_filters"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null"
                android:padding="@dimen/dp_9"
                android:src="@drawable/ic_filter"
                app:tint="@color/color_text" />

            <TextView
                android:id="@+id/tv_filters_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_accent_circle"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="@dimen/dp_16"
                android:minHeight="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_3"
                android:textColor="@color/color_bg"
                android:textSize="@dimen/sp_9_5"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="2"
                tools:visibility="visible" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/matching_tags_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:letterSpacing="0.08"
            android:text="@string/search_matching_tags_label"
            android:textAllCaps="true"
            android:textColor="@color/color_accent_2_700"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_matching_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_tag_chip" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_results_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:paddingHorizontal="@dimen/dp_16"
        android:alpha="0.6"
        android:textColor="@color/color_text"
        android:textSize="@dimen/sp_12_5"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="3 recipes · sorted by rating"
        tools:visibility="visible" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/dp_4"
            android:paddingBottom="@dimen/dp_24"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_search_result_row" />

        <TextView
            android:id="@+id/tv_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/dp_32"
            android:gravity="center"
            android:text="@string/search_empty_prompt"
            android:textColor="@color/color_text"
            android:alpha="0.5"
            android:textSize="@dimen/sp_14" />

        <include layout="@layout/layout_no_results_state" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="@dimen/dp_36"
            android:layout_height="@dimen/dp_36"
            android:layout_gravity="center"
            android:indeterminateTint="@color/color_accent"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
