<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/dp_12">

    <TextView
        android:id="@+id/step_number"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:background="@drawable/bg_accent_circle"
        android:fontFamily="@font/caprasimo"
        android:gravity="center"
        android:textColor="@color/color_bg"
        android:textSize="@dimen/sp_14"
        tools:text="1" />

    <LinearLayout
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_15"
            tools:text="Warm the olive oil and fry the onion and pepper until soft, about 8 minutes." />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/step_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                app:cardCornerRadius="@dimen/dp_16"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="@dimen/dp_0">

                <ImageView
                    android:id="@+id/step_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/step_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:background="@drawable/bg_note_filled"
            android:drawablePadding="@dimen/dp_7"
            android:lineSpacingMultiplier="1.35"
            android:padding="@dimen/dp_10"
            android:textColor="@color/color_accent_2_800"
            android:textSize="@dimen/sp_12_5"
            app:drawableStartCompat="@drawable/ic_edit"
            app:drawableTint="@color/color_accent_2_800"
            tools:text="My note — only 10 minutes on my stove." />

        <LinearLayout
            android:id="@+id/group_step_note_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/et_step_note"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_edit"
                android:gravity="top|start"
                android:hint="@string/label_add_note_step_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:paddingVertical="@dimen/dp_10"
                tools:text="My note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_6"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_step_note_delete"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="@dimen/dp_6"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone"
                    app:tint="@color/color_accent_2_800" />

                <ImageButton
                    android:id="@+id/btn_step_note_save"
                    android:layout_width="@dimen/dp_32"
                    android:layout_height="@dimen/dp_32"
                    android:layout_marginStart="@dimen/dp_4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="@dimen/dp_6"
                    android:src="@drawable/ic_check"
                    app:tint="@color/color_accent_2_800" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_note"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:minWidth="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:paddingHorizontal="@dimen/dp_0"
            android:text="@string/action_add_note"
            android:textSize="@dimen/sp_12" />

    </LinearLayout>

</LinearLayout>
