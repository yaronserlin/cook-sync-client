<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/color_accent_900"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:minWidth="@dimen/dp_0"
            android:minHeight="@dimen/dp_0"
            android:text="@string/action_exit"
            android:textAllCaps="false"
            android:textColor="@color/color_accent_200"
            android:textSize="@dimen/sp_13"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:iconSize="@dimen/dp_16"
            app:iconTint="@color/color_accent_200" />

        <TextView
            android:id="@+id/tv_cook_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/caprasimo"
            android:textColor="@color/color_accent_100"
            android:textSize="@dimen/sp_16"
            tools:text="Shakshuka with feta" />

        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_more_horiz"
            app:tint="@color/color_accent_200" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/ll_progress_bars"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_5"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:orientation="horizontal" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingTop="@dimen/dp_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.16"
                android:textColor="@color/color_accent_300"
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                tools:text="STEP 1 OF 5" />

            <TextView
                android:id="@+id/tv_step_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:fontFamily="@font/figtree"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/color_accent_100"
                android:textSize="@dimen/sp_34"
                tools:text="Whisk the cornflour into a little cold milk until smooth." />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/step_image_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    app:cardCornerRadius="@dimen/dp_16"
                    app:cardElevation="@dimen/dp_0"
                    app:layout_constraintDimensionRatio="16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:strokeWidth="@dimen/dp_0">

                    <ImageView
                        android:id="@+id/step_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/uses_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_18"
                android:background="@drawable/bg_uses_card"
                android:orientation="vertical"
                android:padding="@dimen/dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/cook_this_step_uses"
                    android:textColor="@color/color_accent_300"
                    android:textSize="@dimen/sp_11_5"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/cg_uses"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:chipSpacingHorizontal="@dimen/dp_8"
                    app:chipSpacingVertical="@dimen/dp_8" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_step_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:background="@drawable/bg_note_dashed"
                android:lineSpacingMultiplier="1.3"
                android:padding="@dimen/dp_14"
                android:textColor="@color/color_accent_2_300"
                android:textSize="@dimen/sp_14"
                android:visibility="gone"
                tools:text="My note — only 10 minutes on my stove." />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/timer_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_marginBottom="@dimen/dp_16"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/timer_ring_frame"
                    android:layout_width="@dimen/dp_120"
                    android:layout_height="@dimen/dp_120"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/timer_ring"
                        android:layout_width="@dimen/dp_120"
                        android:layout_height="@dimen/dp_120"
                        android:indeterminate="false"
                        android:max="1000"
                        app:indicatorColor="@color/color_accent_400"
                        app:indicatorSize="@dimen/dp_112"
                        app:trackColor="@color/color_accent_800"
                        app:trackCornerRadius="@dimen/dp_4"
                        app:trackThickness="@dimen/dp_6" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_timer_clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxWidth="@dimen/dp_84"
                            android:maxLines="1"
                            android:fontFamily="@font/caprasimo"
                            android:textColor="@color/color_accent_100"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="@dimen/sp_14"
                            android:autoSizeMaxTextSize="@dimen/sp_27"
                            android:autoSizeStepGranularity="@dimen/sp_1"
                            tools:text="08:00" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/cook_remaining"
                            android:textColor="@color/color_accent_300"
                            android:textSize="@dimen/sp_10_5"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btn_timer_edit"
                        android:layout_width="@dimen/dp_30"
                        android:layout_height="@dimen/dp_30"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_uses_card"
                        android:contentDescription="@string/cook_edit_timer_description"
                        android:padding="@dimen/dp_6"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/color_accent_100" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_16"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/timer_ring_frame"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timer_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        android:insetTop="@dimen/dp_0"
                        android:insetBottom="@dimen/dp_0"
                        android:text="@string/timer_pause"
                        android:textAllCaps="false"
                        android:textColor="@color/color_accent_100"
                        app:backgroundTint="@color/color_accent_800"
                        app:cornerRadius="@dimen/dp_12"
                        app:icon="@drawable/ic_pause"
                        app:iconTint="@color/color_accent_100" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timer_add"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginTop="@dimen/dp_8"
                        android:insetTop="@dimen/dp_0"
                        android:insetBottom="@dimen/dp_0"
                        android:text="@string/cook_timer_add_minute"
                        android:textAllCaps="false"
                        android:textColor="@color/color_accent_100"
                        app:backgroundTint="@color/color_accent_800"
                        app:cornerRadius="@dimen/dp_12" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:orientation="horizontal"
        android:padding="@dimen/dp_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_prev"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:text="@string/action_prev"
            android:textAllCaps="false"
            android:textColor="@color/color_accent_100"
            app:backgroundTint="@color/color_accent_800"
            app:cornerRadius="@dimen/dp_16"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/color_accent_100" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_primary_action"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_58"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_weight="1"
            android:insetTop="@dimen/dp_0"
            android:insetBottom="@dimen/dp_0"
            android:text="@string/cook_next_action"
            android:textAllCaps="false"
            android:textSize="@dimen/sp_17"
            app:backgroundTint="@color/color_accent"
            app:cornerRadius="@dimen/dp_16"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="end"
            app:iconTint="@color/color_bg" />

    </LinearLayout>

</LinearLayout>
