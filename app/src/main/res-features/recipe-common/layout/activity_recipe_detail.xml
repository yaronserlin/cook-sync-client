<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    tools:context=".ui.recipe.detail.RecipeDetailActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="@dimen/dp_80"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/detail_image"
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_0"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="4:3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@tools:sample/backgrounds/scenic" />

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_margin="@dimen/dp_16"
                    android:background="@drawable/bg_white_circle"
                    android:contentDescription="@null"
                    android:elevation="@dimen/dp_4"
                    android:src="@drawable/ic_arrow_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/color_text" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:layout_margin="@dimen/dp_16"
                    android:background="@drawable/bg_white_circle"
                    android:contentDescription="@null"
                    android:elevation="@dimen/dp_4"
                    android:src="@drawable/ic_heart_outline"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/color_accent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/dp_20">

                <TextView
                    android:id="@+id/detail_kicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/color_accent"
                    android:textSize="@dimen/sp_11"
                    android:textStyle="bold"
                    tools:text="Yaron Serlin · published April 2026" />

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:fontFamily="@font/caprasimo"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_28"
                    tools:text="Shakshuka with feta" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_description_blocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_0"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_description_text" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/detail_note_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:cardBackgroundColor="@color/color_accent_2_100"
                    app:cardCornerRadius="@dimen/dp_16"
                    app:cardElevation="@dimen/dp_0"
                    app:strokeWidth="@dimen/dp_0">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_14">

                        <LinearLayout
                            android:id="@+id/group_detail_note_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_detail_note_icon"
                                android:layout_width="@dimen/dp_18"
                                android:layout_height="@dimen/dp_18"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/color_accent_2_800" />

                            <TextView
                                android:id="@+id/tv_detail_note"
                                android:layout_width="@dimen/dp_0"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/dp_10"
                                android:layout_weight="1"
                                android:lineSpacingMultiplier="1.3"
                                android:textColor="@color/color_accent_2_800"
                                android:textSize="@dimen/sp_13"
                                tools:text="Add a private note" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/group_detail_note_edit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <EditText
                                android:id="@+id/et_detail_note"
                                style="@style/CookSync.Input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_note_edit"
                                android:gravity="top|start"
                                android:hint="@string/recipe_add_note_hint"
                                android:inputType="textMultiLine|textCapSentences"
                                android:minLines="2"
                                android:paddingVertical="@dimen/dp_10"
                                tools:text="My note" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_8"
                                android:gravity="end|center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btn_detail_note_delete"
                                    android:layout_width="@dimen/dp_32"
                                    android:layout_height="@dimen/dp_32"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@null"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_delete"
                                    android:visibility="gone"
                                    app:tint="@color/color_accent_2_800" />

                                <ImageButton
                                    android:id="@+id/btn_detail_note_save"
                                    android:layout_width="@dimen/dp_32"
                                    android:layout_height="@dimen/dp_32"
                                    android:layout_marginStart="@dimen/dp_4"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:contentDescription="@null"
                                    android:padding="@dimen/dp_6"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/color_accent_2_800" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/detail_rating_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/dp_4">

                    <ImageView
                        android:layout_width="@dimen/dp_15"
                        android:layout_height="@dimen/dp_15"
                        android:src="@drawable/ic_star"
                        app:tint="@color/color_accent" />

                    <TextView
                        android:id="@+id/detail_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:textColor="@color/color_text"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        tools:text="4.6" />

                    <TextView
                        android:id="@+id/detail_review_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_4"
                        android:alpha="0.6"
                        android:textColor="@color/color_text"
                        android:textSize="@dimen/sp_14"
                        tools:text="· 124 reviews" />

                    <ImageView
                        android:layout_width="@dimen/dp_15"
                        android:layout_height="@dimen/dp_15"
                        android:layout_marginStart="@dimen/dp_2"
                        android:alpha="0.5"
                        android:src="@drawable/ic_arrow_back"
                        android:rotation="180"
                        app:tint="@color/color_text" />

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16">

                    <LinearLayout
                        android:id="@+id/detail_prep_card"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_info_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12"
                        app:layout_constraintEnd_toStartOf="@id/detail_cook_card"
                        app:layout_constraintHorizontal_chainStyle="spread"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_prep"
                            android:alpha="0.6"
                            android:textSize="@dimen/sp_10"
                            android:letterSpacing="0.08" />
                        <TextView
                            android:id="@+id/detail_prep_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caprasimo"
                            android:textSize="@dimen/sp_18"
                            tools:text="15 min" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/detail_cook_card"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:background="@drawable/bg_info_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12"
                        app:layout_constraintEnd_toStartOf="@id/detail_serves_card"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@id/detail_prep_card"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_cook"
                            android:alpha="0.6"
                            android:textSize="@dimen/sp_10"
                            android:letterSpacing="0.08" />
                        <TextView
                            android:id="@+id/detail_cook_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caprasimo"
                            android:textSize="@dimen/sp_18"
                            tools:text="30 min" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/detail_serves_card"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_8"
                        android:background="@drawable/bg_info_card"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_12"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_weight="1"
                        app:layout_constraintStart_toEndOf="@id/detail_cook_card"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_serves"
                            android:alpha="0.6"
                            android:textSize="@dimen/sp_10"
                            android:letterSpacing="0.08" />
                        <TextView
                            android:id="@+id/detail_servings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/caprasimo"
                            android:textSize="@dimen/sp_18"
                            tools:text="4" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_tag_chip" />

                <TextView
                    android:id="@+id/detail_ingredients_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_32"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_20"
                    android:fontFamily="@font/caprasimo"
                    tools:text="Ingredients · 4 servings" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ingredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_ingredient" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_32"
                    android:text="@string/label_instructions"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_20"
                    android:fontFamily="@font/caprasimo" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_instruction_step" />

                <LinearLayout
                    android:id="@+id/detail_reviews_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_32"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/caprasimo"
                        android:text="@string/label_reviews"
                        android:textColor="@color/color_text"
                        android:textSize="@dimen/sp_20" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_review"
                        style="@style/CookSync.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:insetTop="@dimen/dp_0"
                        android:insetBottom="@dimen/dp_0"
                        android:text="@string/action_write_review"
                        android:textSize="@dimen/sp_13" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/dp_20"
                    app:cardElevation="@dimen/dp_0"
                    app:strokeWidth="@dimen/dp_0">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/dp_16">

                        <LinearLayout
                            android:id="@+id/detail_rating_summary_column"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/detail_summary_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/caprasimo"
                                android:textColor="@color/color_text"
                                android:textSize="@dimen/sp_32"
                                tools:text="4.6" />

                            <TextView
                                android:id="@+id/detail_summary_stars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/dp_2"
                                android:textColor="@color/color_accent_700"
                                android:textSize="@dimen/sp_11"
                                tools:text="★★★★★" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="@dimen/dp_0"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_16"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/detail_rating_summary_column"
                            app:layout_constraintTop_toTopOf="parent">

                            <include layout="@layout/item_rating_bar_row" android:id="@+id/bar_row_5" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/bar_row_4" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/bar_row_3" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/bar_row_2" />
                            <include layout="@layout/item_rating_bar_row" android:id="@+id/bar_row_1" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:clipToPadding="false"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/review_star_chip_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <include layout="@layout/item_review_star_chip" android:id="@+id/chip_star_5" />
                        <include layout="@layout/item_review_star_chip" android:id="@+id/chip_star_4" />
                        <include layout="@layout/item_review_star_chip" android:id="@+id/chip_star_3" />
                        <include layout="@layout/item_review_star_chip" android:id="@+id/chip_star_2" />
                        <include layout="@layout/item_review_star_chip" android:id="@+id/chip_star_1" />

                    </LinearLayout>

                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_14"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detail_reviews_summary_label"
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.6"
                        android:textColor="@color/color_text"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        tools:text="6 reviews · filtered by 5★" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_sort_reviews"
                        style="@style/CookSync.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:insetTop="@dimen/dp_0"
                        android:insetBottom="@dimen/dp_0"
                        android:text="@string/filter_sort_newest"
                        android:textSize="@dimen/sp_12_5"
                        app:icon="@drawable/ic_filter"
                        app:iconGravity="textStart"
                        app:iconSize="@dimen/dp_15"
                        app:iconTint="@color/color_accent" />

                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/reviews_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="@dimen/dp_20"
                    app:cardElevation="@dimen/dp_0"
                    app:strokeWidth="@dimen/dp_0"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/dp_24">

                        <ImageView
                            android:layout_width="@dimen/dp_26"
                            android:layout_height="@dimen/dp_26"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/color_accent_700" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:fontFamily="@font/caprasimo"
                            android:text="@string/reviews_empty_filter"
                            android:textColor="@color/color_text"
                            android:textSize="@dimen/sp_17" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_clear_review_filter"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_8"
                            android:text="@string/action_show_all_reviews"
                            android:textAllCaps="false"
                            app:cornerRadius="@dimen/dp_16"
                            app:strokeColor="@color/color_divider" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_reviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_review" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/detail_skeleton"
        layout="@layout/activity_recipe_detail_skeleton" />

    <LinearLayout
        android:id="@+id/detail_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/color_bg"
        android:orientation="horizontal"
        android:padding="@dimen/dp_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_recipe"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_54"
            android:layout_marginEnd="@dimen/dp_12"
            android:paddingHorizontal="@dimen/dp_20"
            android:text="@string/action_edit"
            android:visibility="gone"
            app:cornerRadius="@dimen/dp_16"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_cooking"
            android:layout_width="@dimen/dp_0"
            android:layout_height="@dimen/dp_54"
            android:layout_weight="1"
            android:text="@string/action_start_cooking"
            android:textAllCaps="false"
            android:textSize="@dimen/sp_16"
            app:backgroundTint="@color/color_accent"
            app:cornerRadius="@dimen/dp_16"
            app:icon="@drawable/ic_chef_hat"
            app:iconGravity="textStart"
            app:iconTint="@color/color_bg" />


    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
