<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_16"
    android:layout_marginBottom="@dimen/dp_16"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/dp_28"
    app:cardElevation="@dimen/dp_0"
    app:strokeWidth="@dimen/dp_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_12">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_200"
            app:cardCornerRadius="@dimen/dp_20"
            app:cardElevation="@dimen/dp_0"
            app:strokeWidth="@dimen/dp_0">

            <ImageView
                android:id="@+id/recipe_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/dp_4">

            <!-- Kicker: author name, matching the design's ".card-kicker". -->
            <TextView
                android:id="@+id/author_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/color_accent"
                android:textSize="@dimen/sp_10"
                android:textStyle="bold"
                tools:text="Yaron Serlin" />

            <TextView
                android:id="@+id/recipe_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_3"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                tools:text="Creamy Avocado Pasta" />

            <!-- Blurb: short description, matching the design's ".card-body". -->
            <TextView
                android:id="@+id/recipe_blurb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_5"
                android:alpha="0.8"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_13"
                tools:text="A bright, garlicky weeknight pasta finished with lemon and torn basil." />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_13"
                    android:layout_height="@dimen/dp_13"
                    android:src="@drawable/ic_star"
                    app:tint="@color/color_accent_700" />

                <TextView
                    android:id="@+id/rating_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:textColor="@color/color_accent_700"
                    android:textSize="@dimen/sp_12"
                    android:textStyle="bold"
                    tools:text="4.8" />

                <ImageView
                    android:layout_width="@dimen/dp_13"
                    android:layout_height="@dimen/dp_13"
                    android:layout_marginStart="@dimen/dp_12"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/color_text" />

                <TextView
                    android:id="@+id/time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:alpha="0.7"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_12"
                    tools:text="25 mins" />

                <TextView
                    android:id="@+id/difficulty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_12"
                    tools:text="Easy" />

                <View
                    android:layout_width="@dimen/dp_0"
                    android:layout_height="@dimen/dp_1"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="@dimen/dp_24"
                    android:layout_height="@dimen/dp_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/label_favorite"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/color_accent" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
