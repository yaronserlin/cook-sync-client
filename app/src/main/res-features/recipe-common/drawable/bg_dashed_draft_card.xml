<?xml version="1.0" encoding="utf-8"?>
<!-- Dashed-border "resumable draft" card background on My Recipes, matching the design's
     accent-tinted dashed card. See bg_dashed_add_row.xml for the software-layer-type note. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.5dp"
        android:color="@color/color_accent_400"
        android:dashGap="4dp"
        android:dashWidth="6dp" />
    <corners android:radius="18dp" />
    <solid android:color="@color/color_accent_100" />
</shape>
