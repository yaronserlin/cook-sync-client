<?xml version="1.0" encoding="utf-8"?>
<!-- Card-like background for the tag-autocomplete dropdown popup, replacing the system default
     plain white popup so it matches the app's surface/divider tokens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/color_surface" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/color_divider" />
</shape>
