<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    tools:context=".ui.recipe.wizard.WizardBasicsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:letterSpacing="0.12"
            android:text="@string/wizard_step1_of4"
            android:textColor="@color/color_accent_2_700"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginBottom="@dimen/dp_16"
            android:fontFamily="@font/caprasimo"
            android:text="@string/wizard_step1_heading"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_26" />

        <TextView
            style="@style/CookSync.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wizard_basics_cover_label" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_190">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cover_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/dp_20"
                app:cardElevation="@dimen/dp_0"
                app:strokeWidth="@dimen/dp_0"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_cover_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/btn_pick_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_dashed_cover"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="@dimen/dp_26"
                    android:layout_height="@dimen/dp_26"
                    android:src="@drawable/ic_add"
                    app:tint="@color/color_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_6"
                    android:alpha="0.7"
                    android:text="@string/wizard_action_add_cover_photo"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            style="@style/CookSync.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/wizard_basics_title_label" />

        <EditText
            android:id="@+id/et_title"
            style="@style/CookSync.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/wizard_basics_title_hint"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <TextView
            style="@style/CookSync.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/wizard_basics_description_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_8"
            android:alpha="0.6"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_12"
            android:text="@string/wizard_basics_description_helper" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_description_blocks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input_multiline"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="@dimen/dp_12"
            android:paddingVertical="@dimen/dp_10"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="1"
            tools:listitem="@layout/item_wizard_description_block" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_description_photo"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:minWidth="@dimen/dp_0"
            android:paddingHorizontal="@dimen/dp_0"
            android:text="@string/wizard_action_add_description_photo"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconSize="@dimen/dp_16" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16">

            <LinearLayout
                android:id="@+id/wizard_prep_field"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/wizard_cook_field"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/CookSync.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_prep" />

                <EditText
                    android:id="@+id/et_prep_time"
                    style="@style/CookSync.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="@string/wizard_duration_hint"
                    android:inputType="none"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/wizard_cook_field"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:orientation="vertical"
                app:layout_constraintEnd_toStartOf="@id/wizard_serves_field"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/wizard_prep_field"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/CookSync.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_cook" />

                <EditText
                    android:id="@+id/et_cook_time"
                    style="@style/CookSync.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="center"
                    android:hint="@string/wizard_duration_hint"
                    android:inputType="none"
                    android:maxLines="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/wizard_serves_field"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/wizard_cook_field"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    style="@style/CookSync.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_serves" />

                <EditText
                    android:id="@+id/et_servings"
                    style="@style/CookSync.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="number"
                    android:maxLines="1" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            style="@style/CookSync.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/wizard_basics_difficulty_label" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_44"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/dp_16"
            app:cardElevation="@dimen/dp_0"
            app:strokeColor="@color/color_divider"
            app:strokeWidth="@dimen/dp_1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_difficulty_easy"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_18"
                    android:text="@string/filter_difficulty_easy"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_difficulty_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_18"
                    android:text="@string/filter_difficulty_medium"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chip_difficulty_hard"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/dp_18"
                    android:text="@string/filter_difficulty_hard"
                    android:textSize="@dimen/sp_13"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/CookSync.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/wizard_basics_tags_label" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/actv_tag_input"
                style="@style/CookSync.Input"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:dropDownVerticalOffset="@dimen/dp_6"
                android:hint="@string/wizard_basics_tags_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="1" />

            <ImageButton
                android:id="@+id/btn_add_tag"
                android:layout_width="@dimen/dp_44"
                android:layout_height="@dimen/dp_44"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/bg_input"
                android:contentDescription="@string/wizard_action_add_tag"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add"
                app:tint="@color/color_accent_700" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_selected_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:chipSpacingHorizontal="@dimen/dp_6"
            app:singleLine="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:alpha="0.55"
            android:letterSpacing="0.1"
            android:text="@string/wizard_popular_tags_label"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_11"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_popular_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_6"
            app:chipSpacingHorizontal="@dimen/dp_6"
            app:singleLine="false" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
