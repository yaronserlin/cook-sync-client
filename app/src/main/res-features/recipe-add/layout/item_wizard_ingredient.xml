<?xml version="1.0" encoding="utf-8"?>
<!-- One ingredient row in the Create Recipe wizard's Ingredients step: name, quantity, unit
     picker, and a remove action. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="@dimen/dp_0"
    app:strokeWidth="@dimen/dp_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_ingredient_name"
                style="@style/CookSync.Input"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/wizard_ingredient_name_hint"
                android:inputType="textCapSentences"
                android:maxLines="1"
                tools:text="Eggs" />

            <ImageView
                android:id="@+id/iv_ingredient_drag_handle"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:layout_marginStart="@dimen/dp_8"
                android:contentDescription="@null"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/color_text"
                android:alpha="0.4" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_ingredient_quantity"
                style="@style/CookSync.Input"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/wizard_ingredient_quantity_hint"
                android:inputType="numberDecimal"
                android:maxLines="1"
                tools:text="2" />

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_0" />

            <AutoCompleteTextView
                android:id="@+id/actv_ingredient_unit"
                style="@style/CookSync.Input"
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:hint="@string/wizard_ingredient_unit_hint"
                android:inputType="none"
                android:maxLines="1"
                tools:text="Kilogram (kg)" />

            <ImageButton
                android:id="@+id/btn_remove_ingredient"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginStart="@dimen/dp_8"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wizard_action_remove_ingredient"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                app:tint="@color/color_accent_700" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
