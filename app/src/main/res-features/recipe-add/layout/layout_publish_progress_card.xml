<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_publish_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/dp_16"
    android:layout_marginTop="@dimen/dp_12"
    android:visibility="gone"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="@dimen/dp_2"
    app:strokeColor="@color/color_accent_200"
    app:strokeWidth="@dimen/dp_1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/pb_publish_spinner"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:indeterminateTint="@color/color_accent" />

            <ImageView
                android:id="@+id/iv_publish_success_icon"
                android:layout_width="@dimen/dp_24"
                android:layout_height="@dimen/dp_24"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/color_accent_2_700" />

            <LinearLayout
                android:layout_width="@dimen/dp_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_publish_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree"
                    android:text="@string/wizard_publish_title"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_publish_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:alpha="0.7"
                    android:fontFamily="@font/figtree"
                    android:text="@string/wizard_publish_uploading_media"
                    android:textColor="@color/color_text"
                    android:textSize="@dimen/sp_12" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_publish_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree"
                android:text="@string/wizard_publish_percent_initial"
                android:textColor="@color/color_accent_700"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pb_publish_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:indicatorColor="@color/color_accent"
            app:trackColor="@color/color_accent_100"
            app:trackCornerRadius="@dimen/dp_4" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
