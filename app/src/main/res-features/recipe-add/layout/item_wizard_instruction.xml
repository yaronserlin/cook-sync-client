<?xml version="1.0" encoding="utf-8"?>
<!-- One instruction step card in the Create Recipe wizard's Instructions step: numbered badge,
     description, and a row of tappable pills for the timer and linked ingredients. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_12"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="@dimen/dp_16"
    app:cardElevation="@dimen/dp_0"
    app:strokeWidth="@dimen/dp_0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/dp_12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_instruction_step_number"
                android:layout_width="@dimen/dp_26"
                android:layout_height="@dimen/dp_26"
                android:background="@drawable/bg_step_number_circle"
                android:fontFamily="@font/caprasimo"
                android:gravity="center"
                android:textColor="@color/color_bg"
                android:textSize="@dimen/sp_12"
                tools:text="1" />

            <TextView
                android:id="@+id/tv_instruction_step_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:alpha="0.5"
                android:letterSpacing="0.1"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_11"
                android:textStyle="bold"
                tools:text="STEP 1" />

            <View
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_0"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_instruction_drag_handle"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_22"
                android:alpha="0.35"
                android:contentDescription="@null"
                android:src="@drawable/ic_drag_handle"
                app:tint="@color/color_text" />

            <ImageButton
                android:id="@+id/btn_remove_instruction"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginStart="@dimen/dp_4"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/wizard_action_remove_step"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete"
                app:tint="@color/color_accent_700" />

        </LinearLayout>

        <EditText
            android:id="@+id/et_instruction_description"
            style="@style/CookSync.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:gravity="center_vertical|start"
            android:hint="@string/wizard_instruction_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_instruction_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            app:chipSpacingHorizontal="@dimen/dp_6"
            app:chipSpacingVertical="@dimen/dp_4"
            app:singleLine="false">

            <TextView
                android:id="@+id/tv_instruction_timer_pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_28"
                android:background="@drawable/bg_tag_neutral"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_11"
                android:textColor="@color/color_text"
                android:textSize="@dimen/sp_11_5"
                tools:text="⏱ no timer" />

            <TextView
                android:id="@+id/tv_instruction_add_ingredient_pill"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_28"
                android:background="@drawable/bg_tag_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="@dimen/dp_11"
                android:text="@string/wizard_instruction_add_ingredient_pill"
                android:textColor="@color/color_accent"
                android:textSize="@dimen/sp_11_5" />

        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_instruction_photo"
                style="@style/CookSync.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/dp_0"
                android:paddingHorizontal="@dimen/dp_0"
                android:text="@string/wizard_action_add_step_photo"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconSize="@dimen/dp_16" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_instruction_photo_preview"
                android:layout_width="@dimen/dp_52"
                android:layout_height="@dimen/dp_52"
                android:layout_marginStart="@dimen/dp_10"
                android:visibility="gone"
                app:cardCornerRadius="@dimen/dp_10"
                app:cardElevation="@dimen/dp_0"
                app:strokeWidth="@dimen/dp_0"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/iv_instruction_photo_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
