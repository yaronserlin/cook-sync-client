<?xml version="1.0" encoding="utf-8"?>
<!-- One block in the Basics step's description editor: either a TEXT block (a plain multi-line
     field) or an IMAGE block (thumbnail + caption), reorderable via the drag handle so images
     can be placed wherever the user wants them relative to the text — only one of the two
     content groups is visible at a time, per the bound block's type. Fields are "bare" (no own
     border/background) since the whole list sits inside one unified bordered box in
     fragment_wizard_basics.xml, matching the design's single description "input" containing
     both text and inline photos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/dp_8"
    android:gravity="top"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/iv_block_drag_handle"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginTop="@dimen/dp_6"
        android:alpha="0.35"
        android:contentDescription="@null"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/color_text" />

    <EditText
        android:id="@+id/et_block_text"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/wizard_basics_description_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:minLines="2"
        android:padding="@dimen/dp_0"
        android:textColor="@color/color_text"
        android:textColorHint="@color/color_text_hint"
        android:textSize="@dimen/sp_14" />

    <LinearLayout
        android:id="@+id/ll_block_image"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/dp_56"
            android:layout_height="@dimen/dp_56"
            app:cardCornerRadius="@dimen/dp_12"
            app:cardElevation="@dimen/dp_0"
            app:strokeWidth="@dimen/dp_0">

            <ImageView
                android:id="@+id/iv_block_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

        </com.google.android.material.card.MaterialCardView>

        <EditText
            android:id="@+id/et_block_caption"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/wizard_photo_caption_label"
            android:maxLines="1"
            android:padding="@dimen/dp_0"
            android:textColor="@color/color_text"
            android:textColorHint="@color/color_text_hint"
            android:textSize="@dimen/sp_12" />

        <ImageButton
            android:id="@+id/btn_block_remove"
            android:layout_width="@dimen/dp_28"
            android:layout_height="@dimen/dp_28"
            android:layout_marginStart="@dimen/dp_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_delete"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            app:tint="@color/color_accent_700" />

    </LinearLayout>

</LinearLayout>
