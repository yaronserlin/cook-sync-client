<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.recipe.wizard.AddRecipeWizardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_56"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/dp_8">

        <ImageButton
            android:id="@+id/btn_wizard_close"
            android:layout_width="@dimen/dp_40"
            android:layout_height="@dimen/dp_40"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            app:tint="@color/color_text" />

        <TextView
            android:id="@+id/tv_wizard_title"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/caprasimo"
            android:gravity="center"
            android:text="@string/wizard_title"
            android:textColor="@color/color_text"
            android:textSize="@dimen/sp_18" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_save_draft"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_0"
            android:text="@string/wizard_action_save_draft" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_wizard_steps"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_4"
        android:layout_marginHorizontal="@dimen/dp_16"
        android:max="3"
        android:progressTint="@color/color_accent"
        android:progressBackgroundTint="@color/color_neutral_300" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_wizard_steps"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/dp_16">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_back"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/dp_0"
            android:paddingHorizontal="@dimen/dp_20"
            android:text="@string/action_back" />

        <View
            android:layout_width="@dimen/dp_10"
            android:layout_height="@dimen/dp_0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_draft"
            style="@style/CookSync.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/dp_10"
            android:minWidth="@dimen/dp_0"
            android:paddingHorizontal="@dimen/dp_20"
            android:text="@string/wizard_action_draft"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_wizard_next"
            style="@style/CookSync.Button.Primary"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/wizard_action_next"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="end" />

    </LinearLayout>

</LinearLayout>
