<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp">

    <EditText
        android:id="@+id/et_tag_search"
        style="@style/CookSync.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/admin_tags_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tv_tags_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.55"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/color_text"
        android:textSize="10.5sp"
        android:textStyle="bold"
        tools:text="Likely duplicates · 3 pairs" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_admin_tag_groups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_tags_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/admin_tags_empty"
        android:textColor="@color/color_text"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_info_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            app:tint="@color/color_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:alpha="0.75"
            android:text="@string/admin_merge_dialog_message"
            android:textColor="@color/color_text"
            android:textSize="11.5sp" />

    </LinearLayout>

</LinearLayout>
