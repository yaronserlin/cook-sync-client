<?xml version="1.0" encoding="utf-8"?>
<!--
  Login screen root: FrameLayout overlaying the skeleton and the real form.
  - skeleton_container: shown immediately on start while auto-login token check runs.
    Hidden and replaced by the form if the check fails (or if no session is stored).
  - form_container: the real interactive form. Hidden until skeleton check completes.

  All per-field styles (CookSync.Input, CookSync.Button.Primary, etc.) are defined in
  themes.xml — no inline attribute duplication (DRY).
  All EditText fields carry android:maxLength to enforce hard input-size limits
  matching the server-side @Size constraints on LoginRequestDTO.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <!-- ── Skeleton (shown first) ─────────────────────────────────── -->
    <include
        android:id="@+id/skeleton_container"
        layout="@layout/activity_login_skeleton"
        android:visibility="visible" />

    <!-- ── Real form (hidden until token check resolves) ─────────── -->
    <ScrollView
        android:id="@+id/form_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <!-- ── Brand wordmark ─────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="38sp"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/color_accent"
                android:layout_marginBottom="32dp" />

            <!-- ── Headline ───────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textSize="26sp"
                android:fontFamily="@font/caprasimo"
                android:textColor="@color/color_text"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="8dp" />

            <!-- ── Subtitle ───────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_subtitle"
                android:textSize="14sp"
                android:textColor="@color/color_text"
                android:alpha="0.65"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="36dp" />

            <!-- ── Email field ────────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_email"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_email"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="you@example.com"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:maxLength="254"
                android:autofillHints="emailAddress"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_email_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <!-- ── Password field ─────────────────────────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_password"
                style="@style/CookSync.FieldLabel" />

            <EditText
                android:id="@+id/et_password"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:maxLength="100"
                android:autofillHints="password"
                tools:ignore="Autofill" />

            <TextView
                android:id="@+id/tv_password_error"
                style="@style/CookSync.ErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:visibility="gone" />

            <!-- ── Sign-in button ─────────────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sign_in"
                style="@style/CookSync.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_sign_in"
                android:layout_marginBottom="12dp" />

            <!-- ── Create account button ──────────────────────────────── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_account"
                style="@style/CookSync.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_create_account"
                android:layout_marginBottom="24dp" />

            <!-- ── Loading indicator (hidden by default) ──────────────── -->
            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/color_accent"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ── Footer note ────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_privacy"
                android:textSize="12sp"
                android:textColor="@color/color_text"
                android:alpha="0.45"
                android:layout_gravity="center_horizontal"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
