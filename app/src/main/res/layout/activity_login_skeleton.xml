<?xml version="1.0" encoding="utf-8"?>
<!--
  Login skeleton layout: pixel-faithful placeholder of activity_login.xml.
  Every visual element that has meaningful size is represented by a corresponding
  skeleton bone View with the same approximate dimensions and layout_margins.
  Animated by SkeletonHelper.attachAll() in LoginActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeleton_login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_bg"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="64dp"
    android:paddingBottom="32dp">

    <!-- ── Brand wordmark bone ──────────────────────────────────────── -->
    <View
        android:layout_width="160dp"
        android:layout_height="42dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- ── Headline bone ────────────────────────────────────────────── -->
    <View
        android:layout_width="240dp"
        android:layout_height="28dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- ── Subtitle bones (two lines) ───────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_skeleton_bone" />
    <View
        android:layout_width="200dp"
        android:layout_height="12dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- ── Email field ───────────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Password field ────────────────────────────────────────────── -->
    <include layout="@layout/skeleton_field" />

    <!-- ── Primary button bone ──────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_skeleton_bone_dark" />

    <!-- ── Secondary button bone ─────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bg_skeleton_bone" />

</LinearLayout>
