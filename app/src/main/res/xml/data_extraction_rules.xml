<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample data extraction rules file; uncomment and customize as needed.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Encrypted JWT tokens must never leave the device via backup. -->
        <exclude domain="sharedpref" path="cooksync_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cooksync_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
