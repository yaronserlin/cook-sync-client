<?xml version="1.0" encoding="utf-8"?>
<!-- Body for OrganicConfirmDialog#showWithPasswordConfirm: a danger confirm message followed
     by a password field, used for account deletion re-authentication. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tv_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.85"
        android:textColor="@color/color_text"
        android:textSize="14sp"
        tools:text="Your recipes and reviews will be hidden immediately." />

    <TextView
        style="@style/CookSync.FieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/account_details_dialog_delete_password_hint" />

    <com.cooksync.app.ui.common.PasswordEditText
        android:id="@+id/et_password"
        style="@style/CookSync.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/account_details_dialog_delete_password_hint" />

</LinearLayout>
