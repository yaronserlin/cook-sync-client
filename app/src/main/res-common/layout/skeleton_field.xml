<?xml version="1.0" encoding="utf-8"?>
<!--
  Reusable skeleton component representing a single form field (label line + input pill).
  Use <include layout="@layout/skeleton_field" /> wherever a form skeleton needs one field.
  DRY: extracted here once so Login, Register, and any future form skeletons don't repeat it.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Field label bone -->
    <View
        android:layout_width="90dp"
        android:layout_height="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_skeleton_bone" />

    <!-- Input pill bone -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_skeleton_bone" />

</LinearLayout>
