<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CookSync" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_accent</item>
        <item name="colorPrimaryDark">@color/color_accent_700</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="android:windowBackground">@color/color_bg</item>
        <item name="android:textColorPrimary">@color/color_text</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="CookSync" />

    <!-- Reusable field label, shared across every text-entry field in the app (DRY: see
         requirement to extract repeated UI into styles rather than duplicating attributes). -->
    <style name="CookSync.FieldLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:alpha">0.7</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

    <!-- Reusable text input, matching the design system's pill-shaped ".input" component. -->
    <style name="CookSync.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textColorHint">#73201E1D</item>
    </style>

    <!-- Reusable primary/filled button, matching the design system's ".btn-primary". -->
    <style name="CookSync.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/color_accent</item>
        <item name="android:textColor">@color/color_bg</item>
        <item name="cornerRadius">27dp</item>
    </style>

    <!-- Reusable secondary/outline button, matching the design system's ".btn-secondary". -->
    <style name="CookSync.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="strokeColor">@color/color_divider</item>
        <item name="cornerRadius">27dp</item>
    </style>

    <!-- Reusable ghost/text button, matching the design system's ".btn-ghost". -->
    <style name="CookSync.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_accent</item>
    </style>

    <!-- Reusable danger/filled button: same shape as CookSync.Button.Primary but with the
         darkest accent ramp step instead of the base accent, matching the design's danger
         dialog button (`background: color-accent-800; color: color-bg`) — the
         Organic design system has no separate red hue for destructive actions. -->
    <style name="CookSync.Button.Danger" parent="CookSync.Button.Primary">
        <item name="backgroundTint">@color/color_accent_800</item>
    </style>

    <!-- Reusable "Filters · N" pill button (Home/My Recipes/Favorites). Its active/inactive
         look is toggled at runtime via setBackgroundTintList/setTextColor rather than by
         swapping android:background drawables, since a MaterialButton whose background is
         overwritten with a raw drawable stops going through Material's own shape/tint
         redraw pipeline and can silently fail to repaint on some OEM builds. -->
    <style name="CookSync.Button.FilterChip" parent="Widget.MaterialComponents.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="backgroundTint">@color/color_neutral_300</item>
        <item name="iconTint">@color/color_accent</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <!-- Reusable inline validation error label, matching the design system's ".err". -->
    <style name="CookSync.ErrorText">
        <item name="android:textColor">@color/color_accent_700</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">5dp</item>
    </style>

    <style name="CookSync.Heading" />

    <!-- Reusable screen-title heading, matching the design system's "h2" (Caprasimo, 30px). -->
    <style name="CookSync.Heading.H2">
        <item name="android:fontFamily">@font/caprasimo</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">30sp</item>
    </style>

    <!-- Reusable profile-avatar chip: circular initials badge, matching the design system's
         top-right avatar tap target seen on Discover/Home. -->
    <style name="CookSync.AvatarChip">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_avatar_circle</item>
        <item name="android:fontFamily">@font/caprasimo</item>
        <item name="android:textColor">@color/color_accent_800</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Rounds only the top corners of a modal bottom sheet, matching the design's
         ".sheetbody { border-radius:32px 32px 0 0 }". -->
    <style name="ShapeAppearance.CookSync.BottomSheet" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.CookSync.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CookSync.BottomSheet</item>
        <item name="backgroundTint">@color/color_bg</item>
    </style>

    <!-- Applied to CookSync's modal bottom sheets (e.g. filters) so they pick up the rounded
         top corners above instead of Material's default square-cornered modal sheet. -->
    <style name="Theme.CookSync.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.CookSync.BottomSheet</item>
    </style>

    <!-- Rounds MaterialAlertDialogBuilder's corners to match the design's ".dialog" radius
         (border-radius: calc(radius-lg * 1.15) ≈ 32dp). -->
    <style name="ShapeAppearance.CookSync.Dialog" parent="">
        <item name="cornerSize">32dp</item>
    </style>

    <!-- Confirm/cancel button pair for CookSync's alert dialogs, matching the design's
         ".dialog-actions .btn-primary" (filled accent pill) and ".btn-ghost" (text cancel). -->
    <style name="CookSync.Dialog.Button.Positive" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">46dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/color_accent</item>
        <item name="android:textColor">@color/color_bg</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <!-- Danger variant of the dialog's confirm button, matching the design's danger dialog
         button (`background: color-accent-800; color: color-bg`). -->
    <style name="CookSync.Dialog.Button.Positive.Danger">
        <item name="backgroundTint">@color/color_accent_800</item>
    </style>

    <style name="CookSync.Dialog.Button.Negative" parent="CookSync.Button.Ghost" />

    <!-- Applied to every OrganicConfirmDialog (and, for visual consistency, other
         MaterialAlertDialogBuilder call sites): rounded corners, the app's cream dialog
         surface, a ghost cancel button and a filled accent confirm button, matching the
         design's generic dialog spec. -->
    <style name="ThemeOverlay.CookSync.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.CookSync.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/CookSync.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/CookSync.Dialog.Button.Negative</item>
        <item name="colorSurface">@color/color_surface</item>
    </style>

    <!-- Danger variant: same rounded shape and ghost cancel, but the confirm button uses the
         design's danger fill for destructive actions (delete, deactivate, etc). -->
    <style name="ThemeOverlay.CookSync.Dialog.Danger" parent="ThemeOverlay.CookSync.Dialog">
        <item name="buttonBarPositiveButtonStyle">@style/CookSync.Dialog.Button.Positive.Danger</item>
    </style>

    <!-- Pill shape for the bottom nav's active-item indicator, matching the design system's
         ".pill-on" (56x30dp fully-rounded pill behind the selected item's icon). -->
    <style name="ShapeAppearance.CookSync.Pill" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Active-indicator sizing/color for the bottom nav, matching ".pill-on"
         (56x30dp, color-accent-200). Material's BottomNavigationView defaults this style to
         @null under Widget.MaterialComponents (non-Material3) themes, so it must be set
         explicitly to enable the indicator at all. -->
    <style name="Widget.CookSync.BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:width">56dp</item>
        <item name="android:height">30dp</item>
        <item name="android:color">@color/color_accent_200</item>
        <item name="shapeAppearance">@style/ShapeAppearance.CookSync.Pill</item>
    </style>

    <!-- Shared bottom navigation bar style, matching the design system's ".bnav"/".bitem"
         states: inactive items are 52%-opacity color_text, the selected item's icon sits in
         the accent-200 pill above and its icon+label turn color_accent_800. Applied to every
         screen hosting the bottom nav (Home, Recipe list, Profile) so the look stays a
         single-point fix rather than per-screen attributes. -->
    <style name="Widget.CookSync.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.CookSync.BottomNavigationView.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Re-themes a bare android.widget.NumberPicker to match the Organic palette: the
         picker has no public Material styling surface, so this overrides the theme attrs its
         internal views actually read — colorControlNormal for the up/down arrows and
         selection dividers, android:textColorPrimary for the digit text — instead of reaching
         into its private fields via reflection. Used by the cooking-mode timer-set dialog. -->
    <style name="ThemeOverlay.CookSync.NumberPicker" parent="">
        <item name="colorControlNormal">@color/color_accent</item>
        <item name="android:textColorPrimary">@color/color_text</item>
    </style>
</resources>
