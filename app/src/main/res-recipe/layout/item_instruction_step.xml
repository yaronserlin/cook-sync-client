<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/step_number"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_accent_circle"
        android:fontFamily="@font/caprasimo"
        android:gravity="center"
        android:textColor="@color/color_bg"
        android:textSize="14sp"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/step_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/color_text"
            android:textSize="15sp"
            tools:text="Warm the olive oil and fry the onion and pepper until soft, about 8 minutes." />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/step_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintDimensionRatio="16:9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/step_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/step_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_note_filled"
            android:drawablePadding="7dp"
            android:lineSpacingMultiplier="1.35"
            android:padding="10dp"
            android:textColor="@color/color_accent_2_800"
            android:textSize="12.5sp"
            app:drawableStartCompat="@drawable/ic_edit"
            app:drawableTint="@color/color_accent_2_800"
            tools:text="My note — only 10 minutes on my stove." />

        <LinearLayout
            android:id="@+id/group_step_note_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <EditText
                android:id="@+id/et_step_note"
                style="@style/CookSync.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_note_edit"
                android:gravity="top|start"
                android:hint="@string/label_add_note_step_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:paddingVertical="10dp"
                tools:text="My note" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_step_note_delete"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_delete"
                    android:visibility="gone"
                    app:tint="@color/color_accent_2_800" />

                <ImageButton
                    android:id="@+id/btn_step_note_save"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/color_accent_2_800" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_step_note"
            style="@style/CookSync.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:text="@string/action_add_note"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
