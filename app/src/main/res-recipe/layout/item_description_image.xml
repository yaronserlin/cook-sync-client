<?xml version="1.0" encoding="utf-8"?>
<!-- A single supplementary photo (+ optional caption) shown inline within the recipe
     description, matching the design's descBlocks "figure" concept: a full-width rounded
     image with an optional figcaption below it, interspersed with text blocks rather than
     shown in a horizontal-scroll gallery. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/description_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/description_image_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:alpha="0.6"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/color_text"
        android:textSize="12sp"
        tools:text="The syrup should coat the back of a spoon." />

</LinearLayout>
