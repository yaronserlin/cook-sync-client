<?xml version="1.0" encoding="utf-8"?>
<!-- Hours/minutes/seconds picker shown when the user taps the cooking-mode timer clock to
     change its duration. NumberPickers are individually re-themed via
     ThemeOverlay.CookSync.NumberPicker (see themes.xml) since the widget has no public
     Material styling of its own, and captioned with H / MM / SS so the control reads as
     intentional rather than three bare system wheels. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_hours"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="H"
                android:textColor="@color/color_accent_700"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text=":"
            android:textColor="@color/color_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_minutes"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="MM"
                android:textColor="@color/color_accent_700"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text=":"
            android:textColor="@color/color_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <NumberPicker
                android:id="@+id/np_seconds"
                android:theme="@style/ThemeOverlay.CookSync.NumberPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:text="SS"
                android:textColor="@color/color_accent_700"
                android:textSize="10.5sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
